# --- Server / DB ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Set when behind a reverse proxy (e.g. 1) so rate limiting sees the real client IP
# TRUST_PROXY=1

# --- JWT (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
# Two DIFFERENT secrets, each at least 32 characters.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
JWT_ISSUER=eds-backend
JWT_AUDIENCE=eds-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Cookies ---
# lax | strict | none (none requires HTTPS; use it only if the frontend is on a different site)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# Cookies are always Secure when NODE_ENV=production; set true to force it elsewhere
# COOKIE_SECURE=false

# --- CORS / Frontend (frontend not decided yet; fill in later) ---
# Comma-separated list of allowed browser origins, e.g. http://localhost:5173
CORS_ORIGINS=
# If set, the Google callback redirects here; if empty it returns JSON.
FRONTEND_URL=
# FRONTEND_SUCCESS_PATH=/
# FRONTEND_LOGIN_PATH=/login

# --- Login rate limiting ---
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
